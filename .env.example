# Mealie Connection Settings
MEALIE_BASE_URL=http://192.168.1.50:9000
MEALIE_API_TOKEN=your_mealie_api_bearer_token_here
MEALIE_GROUP_SLUG=home   # Defaults to 'home' for standard Mealie URLs (e.g. /g/home/r/<slug>)

# Web Server Port
PORT=8000

# Set to true to test with built-in mock recipes without connecting to Mealie
MOCK_MODE=false

# Push Notifications (ntfy.sh)
# Choose any unique secret topic name (e.g. dinner-rob-family-8374)
# Subscribe to this topic in the free ntfy mobile app (iOS/Android)
NTFY_TOPIC=dinner-decider-myfamily
NTFY_BASE_URL=https://ntfy.sh
# NTFY_TOKEN=  # (Optional: Only if you protect your topic with an auth token)

# Pantry Inventory Database Path (Optional, defaults to data/pantry.db)
# PANTRY_DB_PATH=data/pantry.db
